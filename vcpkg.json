{
  "name": "scantailor-advanced",
  "version-string": "0.0.0",
  "dependencies": [
    "boost-intrusive",
    "boost-iterator",
    "boost-multi-index",
    {
      "name": "libjpeg-turbo",
      "default-features": false
    },
    "libpng",
    "tiff",
    "zlib"
  ],
  "default-features": [
    "vcpkg-qt"
  ],
  "features": {
    "tests": {
      "description": "Build the Boost unit tests",
      "dependencies": [
        "boost-test"
      ]
    },
    "vcpkg-qt": {
      "description": "Build and use Qt from vcpkg",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "freetype",
            "gui",
            "harfbuzz",
            "network",
            "opengl",
            "testlib",
            "widgets"
          ]
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "fontconfig",
            "xcb"
          ],
          "platform": "linux"
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "windeployqt"
          ],
          "platform": "windows"
        },
        "qtsvg",
        {
          "name": "qttools",
          "default-features": false,
          "features": [
            "linguist"
          ]
        }
      ]
    }
  }
}
