<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.scantailor.Advanced</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>@APPLICATION_DISPLAY_NAME@</name>
  <summary>Interactive post-processing tool for scanned pages</summary>
  <description>
    <p>Prepare scanned pages for printing or publishing by splitting, deskewing, and cleaning them.</p>
  </description>
  <url type="homepage">https://github.com/karnigen/scantailor-advanced</url>
  <launchable type="desktop-id">org.scantailor.Advanced.desktop</launchable>
  <releases>
    <release version="@VERSION@" type="development" date="@FLATPAK_BUILD_DATE@"/>
  </releases>
</component>
